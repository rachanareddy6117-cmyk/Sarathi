# Copy to .env and fill in. Everything is optional: the app runs with free OpenStreetMap services by default.
SECRET_KEY=change-me
# Real traffic-signal controller (needs agreement with your city traffic dept). Leave empty for simulation mode.
SIGNAL_API_URL=
SIGNAL_API_KEY=
# Webhook that receives every emergency alert (police control room / 112 gateway / Slack / Twilio function)
EMERGENCY_WEBHOOK_URL=
EMERGENCY_WEBHOOK_KEY=
# Optional AI photo classification (Anthropic API). Leave empty to use the type chosen by the user.
ANTHROPIC_API_KEY=
